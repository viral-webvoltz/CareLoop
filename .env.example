# Where the CRM backend runs (no /api/v1 suffix)
CRM_BASE_URL=http://localhost:4000
# CRM -> API keys. Scopes needed: leads.create, leads.view, contacts.create, tickets.create
CRM_API_KEY=crm_...
# Returned once when the webhook endpoint is registered in the CRM (POST /api/v1/webhooks)
CRM_WEBHOOK_SECRET=
# Demo only: same value as INBOUND_EMAIL_SECRET on the CRM. Enables the "simulate a reply" button.
CRM_INBOUND_SECRET=
